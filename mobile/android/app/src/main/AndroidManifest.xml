            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconStreak6" android:targetActivity=".AppActivity" android:exported="true" android:enabled="false" android:icon="@mipmap/ic_launcher_streak_6" android:roundIcon="@mipmap/ic_launcher_streak_6" android:label="@string/counterbase_app_label">
