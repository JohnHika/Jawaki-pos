# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_system?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Daraja (M-Pesa) Configuration
DARAJA_CONSUMER_KEY=your-daraja-consumer-key
DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
DARAJA_PASSKEY=your-daraja-passkey
DARAJA_SHORTCODE=174379
DARAJA_CALLBACK_URL=https://your-domain.com/api/v1/payments/mpesa/callback
DARAJA_ENV=sandbox

# PesaPal Configuration
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_URL=https://your-domain.com/api/v1/payments/pesapal/ipn
PESAPAL_ENV=sandbox

# TouristTap Configuration
TOURISTTAP_API_KEY=your-touristtap-api-key
TOURISTTAP_MERCHANT_ID=your-merchant-id
TOURISTTAP_CALLBACK_URL=https://your-domain.com/api/v1/payments/touristtap/callback

# NVIDIA AI (optional - set API key to enable)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Sync Configuration
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5000
