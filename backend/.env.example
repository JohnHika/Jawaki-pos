# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_system?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# NVIDIA AI (optional - set API key to enable)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Sync Configuration
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY=5000

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Paystack — AI subscription billing (card payments, auto-renewal)
# Get these from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# AI billing kill switch — "true" makes AI free for everyone (no
# subscription check). Must be "false" in production once billing is live.
AI_BILLING_DISABLED=true

# Equity/Finserve Jenga M-Pesa STK Push
# Create sandbox credentials at https://jengapgw.io/. Never commit real values.
JENGA_ENV=sandbox
JENGA_API_KEY=
JENGA_MERCHANT_CODE=
JENGA_CONSUMER_SECRET=
# RSA private key PEM. In hosted environments, encode newlines as \\n.
JENGA_PRIVATE_KEY=
JENGA_ACCOUNT_NUMBER=
JENGA_MERCHANT_NAME=
JENGA_CALLBACK_URL=https://your-api.example.com/api/v1/payments/mpesa/callback

# Android App Updates
# Preferred: point the backend at a remote manifest that GitHub Actions publishes to Cloudflare R2.
ANDROID_APP_MANIFEST_URL=
ANDROID_APP_MANIFEST_TIMEOUT_MS=5000

# Fallback/local-only update configuration (used when ANDROID_APP_MANIFEST_URL is empty or unreachable).
ANDROID_APP_LATEST_VERSION=1.0.2
ANDROID_APP_MIN_SUPPORTED_VERSION=1.0.2
ANDROID_APP_FORCE_UPDATE=true
ANDROID_APP_APK_URL=/api/v1/app-updates/android/download
ANDROID_APP_APK_FILE_PATH=
ANDROID_APP_RELEASE_NOTES=Required update with in-app installer support and remote rollout improvements.
ANDROID_APP_PUBLISHED_AT=2026-06-02T12:00:00Z

# GitHub Release (secondary update source)
# Set GITHUB_REPO to your GitHub repo (e.g., JohnHika/Jawaki-pos)
# GITHUB_TOKEN is optional for public repos (not required for API access)
GITHUB_REPO=JohnHika/Jawaki-pos
GITHUB_TOKEN=
