// Prisma Schema for Hybrid Multi-Branch POS System
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== TENANT & ORGANIZATION ====================

model Tenant {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  logo         String?
  logoPublicId String?
  isActive     Boolean  @default(true)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branches   Branch[]
  users      User[]
  categories Category[]
  products   Product[]
  roles      Role[]

  @@map("tenants")
}

model Branch {
  id          String   @id @default(uuid())
  tenantId    String
  posClientId String?
  name        String
  code        String
  address     String?
  phone       String?
  email       String?
  timezone    String   @default("Africa/Nairobi")
  isActive    Boolean  @default(true)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posClient             PosClient?             @relation(fields: [posClientId], references: [id])
  devices               Device[]
  users                 UserBranch[]
  stock                 Stock[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  priceOverrides        BranchPriceOverride[]
  stockRequests         StockRequest[]
  expenses              Expense[]
  manualPaymentRequests ManualPaymentRequest[]
  aiSubscription        AiSubscription?
  supplierInvoices      SupplierInvoice[]
  cashSettings          BranchCashSettings?
  cashLedgerEntries     CashLedgerEntry[]
  cashReconciliations   CashReconciliation[]
  dailyBriefs           DailyBrief[]

  @@unique([tenantId, code])
  @@map("branches")
}

model Device {
  id           String    @id @default(uuid())
  branchId     String
  deviceUuid   String    @unique
  name         String
  model        String?
  osVersion    String?
  appVersion   String?
  lastSyncAt   DateTime?
  lastActiveAt DateTime?
  isActive     Boolean   @default(true)
  registeredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  syncEvents SyncEvent[]
  sales      Sale[]

  @@map("devices")
}

// One row per (user, physical device) that has granted notification
// permission — a user can be signed into more than one device, and a push
// needs to reach all of them. Kept separate from Device (which is
// branch-scoped and registered independently of any user) since token
// delivery is inherently a per-user, per-install concept.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  deviceUuid String?
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ==================== USERS & AUTHENTICATION ====================

// Legacy fixed role enum — superseded by the granular Permission/Role
// system below. Kept alongside User.role during rollout so existing
// RolesGuard-gated endpoints keep working while endpoints are migrated
// to PermissionsGuard one module at a time; dropped once that's complete.
enum LegacyUserRole {
  CASHIER
  SUPERVISOR
  MANAGER
  ADMIN
}

model User {
  id                   String         @id @default(uuid())
  tenantId             String
  email                String
  phone                String?
  passwordHash         String
  firstName            String
  lastName             String
  role                 LegacyUserRole @default(CASHIER)
  pin                  String? // For quick POS login
  // Separate from `pin`: authorizes logging into a phone-acting-as-local-
  // server (offline mode) as this user. Kept distinct from the online quick-
  // login PIN so a device operating fully offline never needs the online
  // credential, and revoking one doesn't affect the other. Set via
  // POST /auth/offline-access-pin; never returned by any API in plaintext
  // — only the hash travels to phone-server devices via the offline
  // directory sync (GET /users/offline-directory), where it's verified
  // entirely on-device.
  offlineAccessPinHash String?
  avatar               String?
  isActive             Boolean        @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant                     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches                   UserBranch[]
  sales                      Sale[]
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  stockRequestsCreated       StockRequest[]           @relation("RequestedByUser")
  stockRequestsResolved      StockRequest[]           @relation("ResolvedByUser")
  expensesCreated            Expense[]
  expensesApproved           Expense[]                @relation("ExpenseApprovedBy")
  manualPaymentsCreated      ManualPaymentRequest[]   @relation("ManualPaymentRequestedBy")
  manualPaymentsApproved     ManualPaymentRequest[]   @relation("ManualPaymentApprovedBy")
  supplierInvoicesCreated    SupplierInvoice[]
  supplierPaymentsCreated    SupplierPayment[]
  cashReconciliationsCounted CashReconciliation[]
  roles                      UserRole[]
  permissionOverrides        UserPermissionOverride[]
  pushTokens                 PushToken[]

  @@unique([tenantId, email])
  @@map("users")
}

// ==================== GRANULAR PERMISSIONS ====================

// Fixed, seeded catalog of granular capability keys (e.g. "products.create").
// Not tenant-editable — grows only via app updates / seed script changes.
model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  feature     String
  action      String
  label       String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([feature])
  @@map("permissions")
}

// Tenant-scoped, admin-editable bundle of permissions. Seeded with 4
// defaults per tenant (Cashier/Supervisor/Manager/Admin) that reproduce
// today's LegacyUserRole access levels, but admins can rename, reshape,
// or create additional roles.
model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id            String   @id @default(uuid())
  roleId        String
  permissionKey String
  createdAt     DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

// Join table: which role(s) a user holds. Replaces the single
// User.role/LegacyUserRole field — a user can hold multiple roles at once.
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// Per-user grant/revoke exceptions layered on top of role-derived
// permissions. A revoke always wins over any role grant for that key.
model UserPermissionOverride {
  id            String   @id @default(uuid())
  userId        String
  permissionKey String
  grant         Boolean
  reason        String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([userId])
  @@map("user_permission_overrides")
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@map("user_branches")
}

model RefreshToken {
  id                String   @id @default(uuid())
  userId            String
  tokenHash         String   @unique // Hashed token for security
  deviceId          String?
  deviceFingerprint String? // Device binding for theft detection
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==================== CATALOG & PRICING ====================

model Category {
  id            String   @id @default(uuid())
  tenantId      String
  parentId      String?
  name          String
  slug          String
  description   String?
  image         String?
  imagePublicId String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@unique([tenantId, slug])
  @@map("categories")
}

model Product {
  id               String   @id @default(uuid())
  tenantId         String
  sku              String
  name             String
  description      String?
  image            String?
  imagePublicId    String?
  basePrice        Decimal  @db.Decimal(10, 2)
  costPrice        Decimal? @db.Decimal(10, 2)
  taxRate          Decimal  @default(0) @db.Decimal(5, 2)
  unit             String   @default("piece")
  minStock         Int      @default(0)
  trackInventory   Boolean  @default(true)
  allowFractions   Boolean  @default(false)
  isActive         Boolean  @default(true)
  isFavorite       Boolean  @default(false)
  sortOrder        Int      @default(0)
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories           ProductCategory[]
  stock                Stock[]
  saleItems            SaleItem[]
  priceOverrides       BranchPriceOverride[]
  stockMovements       StockMovement[]
  stockRequests        StockRequest[]
  supplierInvoiceItems SupplierInvoiceItem[]
  pricingTiers         ProductPricingTier[]

  @@unique([tenantId, sku])
  @@map("products")
}

// A product can be sold in any number of bulk units beyond its base unit
// (e.g. piece, dozen, carton, pallet) — each with its own real price and
// how many base units it represents. Replaces the old fixed
// secondary/tertiary columns, which capped every product at exactly 2
// extra tiers regardless of how the shop actually sells.
model ProductPricingTier {
  id              String   @id @default(uuid())
  productId       String
  unit            String
  quantityPerUnit Decimal  @db.Decimal(10, 3) // how many base units = 1 of this tier's unit
  price           Decimal  @db.Decimal(10, 2) // real price for one of this tier's unit
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_pricing_tiers")
}

model ProductCategory {
  id         String   @id @default(uuid())
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model BranchPriceOverride {
  id        String    @id @default(uuid())
  branchId  String
  productId String
  price     Decimal   @db.Decimal(10, 2)
  startDate DateTime?
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
  @@map("branch_price_overrides")
}

// ==================== INVENTORY ====================

model Stock {
  id          String   @id @default(uuid())
  branchId    String
  productId   String
  quantity    Decimal  @db.Decimal(10, 3)
  reservedQty Decimal  @default(0) @db.Decimal(10, 3)
  updatedAt   DateTime @updatedAt

  branch  Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches StockBatch[]

  @@unique([branchId, productId])
  @@map("stock")
}

model StockBatch {
  id              String    @id @default(uuid())
  stockId         String
  batchNumber     String
  quantity        Decimal   @db.Decimal(10, 3)
  reservedQty     Decimal   @default(0) @db.Decimal(10, 3)
  expiryDate      DateTime?
  manufactureDate DateTime?
  costPrice       Decimal?  @db.Decimal(10, 2)
  supplierRef     String? // Supplier reference or invoice number
  notes           String?
  isBlocked       Boolean   @default(false) // Manually block expired/damaged batches
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stock     Stock           @relation(fields: [stockId], references: [id], onDelete: Cascade)
  saleItems SaleItemBatch[]

  @@unique([stockId, batchNumber])
  @@index([expiryDate])
  @@index([stockId, expiryDate])
  @@map("stock_batches")
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  REFUND
  DAMAGE
  OPENING
  EXPIRY
  BATCH_RECEIVE
}

model StockMovement {
  id          String            @id @default(uuid())
  branchId    String
  productId   String
  batchId     String? // Link to batch if applicable
  type        StockMovementType
  quantity    Decimal           @db.Decimal(10, 3)
  previousQty Decimal           @db.Decimal(10, 3)
  newQty      Decimal           @db.Decimal(10, 3)
  batchNumber String? // Denormalized batch tracking
  expiryDate  DateTime? // Denormalized expiry tracking
  reference   String? // e.g., sale ID, transfer ID
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([branchId, productId])
  @@index([createdAt])
  @@index([batchId])
  @@map("stock_movements")
}

model StockTransfer {
  id           String   @id @default(uuid())
  fromBranchId String
  toBranchId   String
  status       String   @default("pending") // pending, in_transit, completed, cancelled
  notes        String?
  createdById  String
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id           String   @id @default(uuid())
  transferId   String
  productId    String
  requestedQty Decimal  @db.Decimal(10, 3)
  sentQty      Decimal? @db.Decimal(10, 3)
  receivedQty  Decimal? @db.Decimal(10, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

// ==================== STOCK REQUESTS ====================

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
  CANCELLED
}

model StockRequest {
  id            String        @id @default(uuid())
  branchId      String
  requestedById String
  productId     String
  quantity      Decimal       @db.Decimal(10, 3)
  unit          String        @default("piece")
  reason        String?
  priority      String        @default("normal") // low, normal, high, urgent
  status        RequestStatus @default(PENDING)
  images        String[]      @default([])
  resolvedById  String?
  resolvedAt    DateTime?
  resolution    String? // Approval/rejection notes
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedByUser", fields: [requestedById], references: [id])
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  resolvedBy  User?   @relation("ResolvedByUser", fields: [resolvedById], references: [id])

  @@index([branchId, status])
  @@index([requestedById])
  @@index([status, createdAt])
  @@map("stock_requests")
}

// ==================== SALES & RECEIPTS ====================

enum SaleStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
  PARTIAL_REFUND
}

enum PaymentMethod {
  CASH
  MPESA
  PESAPAL
  TOURISTTAP
  CREDIT
  SPLIT
}

model Sale {
  id             String        @id @default(uuid())
  branchId       String
  deviceId       String?
  userId         String
  receiptNumber  String        @unique
  customerId     String?
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  paidAmount     Decimal       @db.Decimal(10, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  notes          String?
  metadata       Json          @default("{}")
  offlineId      String?       @unique // Original ID from device
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch               Branch                @relation(fields: [branchId], references: [id])
  device               Device?               @relation(fields: [deviceId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])
  items                SaleItem[]
  payments             Payment[]
  refunds              Refund[]
  manualPaymentRequest ManualPaymentRequest?

  @@index([branchId, createdAt])
  @@index([receiptNumber])
  @@map("sales")
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  productId   String
  productName String // Denormalized for receipt
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  batches SaleItemBatch[]

  @@map("sale_items")
}

model SaleItemBatch {
  id           String    @id @default(uuid())
  saleItemId   String
  stockBatchId String
  quantity     Decimal   @db.Decimal(10, 3)
  batchNumber  String // Denormalized for tracking
  expiryDate   DateTime? // Denormalized for tracking

  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id])

  @@map("sale_item_batches")
}

model Customer {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  phone         String?
  email         String?
  address       String?
  loyaltyPoints Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales Sale[]

  @@map("customers")
}

// ==================== PAYMENTS ====================

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id               String        @id @default(uuid())
  saleId           String
  method           PaymentMethod
  amount           Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  transactionId    String? // External transaction ID
  providerResponse Json? // Full response from payment provider
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([transactionId])
  @@map("payments")
}

model MpesaTransaction {
  id                 String    @id @default(uuid())
  merchantRequestId  String    @unique
  checkoutRequestId  String    @unique
  phoneNumber        String
  amount             Decimal   @db.Decimal(10, 2)
  accountReference   String
  transactionDesc    String?
  resultCode         Int?
  resultDesc         String?
  mpesaReceiptNumber String?
  transactionDate    DateTime?
  status             String    @default("pending")
  callbackPayload    Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("mpesa_transactions")
}

model PesapalTransaction {
  id                String   @id @default(uuid())
  orderTrackingId   String   @unique
  merchantReference String
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("KES")
  description       String?
  paymentMethod     String?
  status            String   @default("pending")
  statusCode        Int?
  message           String?
  paymentAccountRef String?
  ipnPayload        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pesapal_transactions")
}

model TouristTapTransaction {
  id               String   @id @default(uuid())
  transactionRef   String   @unique
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("KES")
  customerRef      String?
  status           String   @default("pending")
  providerResponse Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("touristtap_transactions")
}

// ==================== MANUAL PAYMENT REQUESTS ====================

enum ManualPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model ManualPaymentRequest {
  id              String              @id @default(uuid())
  requestNumber   String              @unique
  saleId          String?             @unique // Optional: link to existing sale (one-to-one)
  branchId        String
  requestedById   String
  approvedById    String?
  paymentMethod   String // Manual payment method (cash, mpesa, etc.)
  amount          Decimal             @db.Decimal(10, 2)
  reason          String
  status          ManualPaymentStatus @default(PENDING)
  notes           String?
  rejectionReason String?
  approvedAt      DateTime?
  completedAt     DateTime?
  metadata        Json                @default("{}")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  branch      Branch @relation(fields: [branchId], references: [id])
  requestedBy User   @relation("ManualPaymentRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?  @relation("ManualPaymentApprovedBy", fields: [approvedById], references: [id])
  sale        Sale?  @relation(fields: [saleId], references: [id])

  @@index([branchId, status])
  @@index([status, createdAt])
  @@index([requestedById])
  @@map("manual_payment_requests")
}

// ==================== EXPENSES ====================

enum ExpenseCategory {
  UTILITIES
  RENT
  SALARIES
  INVENTORY
  MARKETING
  MAINTENANCE
  TRANSPORT
  SUPPLIES
  INSURANCE
  TAXES
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id            String          @id @default(uuid())
  expenseNumber String          @unique
  category      ExpenseCategory
  branchId      String
  supplier      String
  reference     String? // Invoice or receipt number
  description   String
  amount        Decimal         @db.Decimal(10, 2)
  status        ExpenseStatus   @default(PENDING)
  date          DateTime
  paymentMethod String?
  notes         String?
  receiptImages String[]        @default([])
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  offlineId     String?         @unique
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  branch     Branch        @relation(fields: [branchId], references: [id])
  createdBy  User          @relation(fields: [createdById], references: [id])
  approvedBy User?         @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  items      ExpenseItem[]

  @@index([branchId, date])
  @@index([category, status])
  @@index([status, createdAt])
  @@map("expenses")
}

model ExpenseItem {
  id          String   @id @default(uuid())
  expenseId   String
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("expense_items")
}

// ==================== REFUNDS ====================

model Refund {
  id            String    @id @default(uuid())
  saleId        String
  amount        Decimal   @db.Decimal(10, 2)
  reason        String
  status        String    @default("pending")
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sale  Sale         @relation(fields: [saleId], references: [id])
  items RefundItem[]

  @@map("refunds")
}

model RefundItem {
  id          String  @id @default(uuid())
  refundId    String
  saleItemId  String
  quantity    Decimal @db.Decimal(10, 3)
  amount      Decimal @db.Decimal(10, 2)
  restockItem Boolean @default(true)

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@map("refund_items")
}

// ==================== SYNC & EVENTS ====================

enum SyncEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  COMPLETED
  FAILED
  CONFLICT
  RESOLVED
}

enum SyncEventType {
  SALE_CREATE
  SALE_CREATED
  SALE_VOID
  SALE_VOIDED
  REFUND_CREATE
  REFUND_CREATED
  STOCK_ADJUSTMENT
  STOCK_ADJUSTED
  STOCK_TRANSFER_CREATED
  PRODUCT_UPDATED
  CATEGORY_UPDATED
  PRICE_OVERRIDE_UPDATED
  USER_UPDATED
  CUSTOMER_CREATE
  CUSTOMER_UPDATE
  SUPPLIER_INVOICE_CREATED
  SUPPLIER_PAYMENT_RECORDED
}

model SyncEvent {
  id              String          @id @default(uuid())
  deviceId        String
  branchId        String
  userId          String
  eventType       SyncEventType
  eventId         String // Original event ID from device
  entityId        String? // Server-side entity ID after processing
  entityType      String? // Type of entity processed
  payload         Json
  status          SyncEventStatus @default(PENDING)
  attempts        Int             @default(0)
  retryCount      Int             @default(0)
  resolution      String? // Conflict resolution strategy used
  error           String? // Error details if failed
  errorMessage    String?
  processedAt     DateTime?
  deviceTimestamp DateTime // When event occurred on device
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, eventId])
  @@index([status, createdAt])
  @@map("sync_events")
}

// ==================== AUDIT & LOGGING ====================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum ConflictType {
  CONCURRENT_UPDATE
  DELETED_ON_SERVER
  NEWER_VERSION_EXISTS
  DUPLICATE_CREATE
}

enum ConflictResolution {
  SERVER_WINS
  CLIENT_WINS
  MERGE
  MANUAL
}

model ConflictLog {
  id           String             @id @default(uuid())
  tableName    String
  recordId     String
  conflictType ConflictType
  resolution   ConflictResolution
  serverData   Json?
  clientData   Json?
  resolvedData Json?
  notes        String?
  createdAt    DateTime           @default(now())
  createdBy    String?

  @@index([tableName, recordId])
  @@index([conflictType])
  @@index([createdAt])
  @@map("conflict_logs")
}

// ==================== AI SUBSCRIPTIONS & BILLING ====================

model PosClient {
  id        String   @id @default(uuid())
  name      String // e.g., 'Levisa', 'TSL', 'Kate'
  slug      String   @unique
  logo      String?
  isActive  Boolean  @default(true)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[]

  @@map("pos_clients")
}

enum AiSubscriptionStatus {
  TRIAL // legacy — no longer granted; kept so existing rows still validate
  UNPAID
  ACTIVE
  EXPIRED
  CANCELLED
}

model AiSubscription {
  id                        String               @id @default(uuid())
  branchId                  String               @unique
  status                    AiSubscriptionStatus @default(UNPAID)
  trialStartedAt            DateTime?
  trialEndsAt               DateTime?
  subscribedAt              DateTime?
  expiresAt                 DateTime?
  autoRenew                 Boolean              @default(true)
  price                     Decimal              @default(1500.00) @db.Decimal(10, 2)
  mpesaPhone                String? // Store owner's M-Pesa phone (legacy manual flow)
  smsPermission             Boolean              @default(false)
  // Paystack recurring billing — set once the customer's first card
  // charge succeeds, then reused by the renewal cron with no customer
  // action needed.
  paystackCustomerCode      String?
  paystackCustomerEmail     String?
  paystackAuthorizationCode String?
  lastRenewalAttemptAt      DateTime?
  renewalFailureCount       Int                  @default(0)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payments AiPayment[]

  @@index([status])
  @@index([expiresAt])
  @@map("ai_subscriptions")
}

enum AiPaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AiPaymentMethod {
  MPESA_MANUAL
  PAYSTACK_CARD
}

model AiPayment {
  id                String          @id @default(uuid())
  subscriptionId    String
  method            AiPaymentMethod @default(MPESA_MANUAL)
  mpesaCode         String?         @unique
  paystackReference String?         @unique
  amount            Decimal         @db.Decimal(10, 2)
  senderPhone       String?
  recipientPhone    String?         @default("0742126582")
  smsRaw            String?
  isRenewal         Boolean         @default(false)
  verified          Boolean         @default(false)
  status            AiPaymentStatus @default(PENDING)
  verifiedAt        DateTime?
  verifiedBy        String? // 'auto_sms' | 'admin_manual' | 'paystack_webhook' | 'paystack_renewal_cron'
  adminNotes        String?
  createdAt         DateTime        @default(now())

  subscription AiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("ai_payments")
}

// Pre-generated once daily by a cron job (see AiDailyBriefTask) so the
// dashboard's "AI Brief" card can show a real insight instantly instead of
// waiting on a live model call every time the dashboard opens. One row per
// branch per day; `content` is the assistant's own natural-language text.
model DailyBrief {
  id        String   @id @default(uuid())
  branchId  String
  date      DateTime @db.Date
  content   String
  model     String?
  createdAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([branchId, date])
  @@map("daily_briefs")
}

// ==================== AI CHAT (shared per shop) ====================

// One shared AI conversation thread, scoped to a tenant (+ optional
// branch). All staff of that shop see and continue the same thread, so the
// AI history is a shop asset, not a per-device silo. "New conversation"
// archives the current active thread and starts a fresh one.
model AiConversation {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([tenantId, branchId, status])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // user | assistant
  content        String
  attachments    Json     @default("[]")
  createdById    String? // the staff member who sent it (user turns)
  createdByName  String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// Durable, tenant-scoped memory the AI recalls across sessions (owner
// preferences, recurring customers, store policies, facts). Shared like
// the chat. Relevance selection is keyword/recency for now (no vector DB).
model AiMemory {
  id        String   @id @default(uuid())
  tenantId  String
  type      String // preference | customer | policy | fact
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, type])
  @@map("ai_memories")
}

// ==================== SUPPLIERS & RESTOCKING ====================

model Supplier {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoices SupplierInvoice[]
  payments SupplierPayment[]

  @@unique([tenantId, name])
  @@map("suppliers")
}

enum SupplierInvoiceStatus {
  OPEN
  PARTIAL
  PAID
}

enum CashFundingSource {
  CASH_TILL
  CREDIT_SUPPLIER
}

model SupplierInvoice {
  id              String                @id @default(uuid())
  tenantId        String
  branchId        String
  supplierId      String
  invoiceNumber   String?
  receiptImageUrl String?
  subtotal        Decimal               @db.Decimal(10, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal               @db.Decimal(10, 2)
  dueAmount       Decimal               @db.Decimal(10, 2)
  dueDate         DateTime?
  status          SupplierInvoiceStatus @default(OPEN)
  fundingSource   CashFundingSource     @default(CASH_TILL)
  offlineId       String?               @unique
  createdById     String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  branch    Branch                @relation(fields: [branchId], references: [id])
  supplier  Supplier              @relation(fields: [supplierId], references: [id])
  createdBy User                  @relation(fields: [createdById], references: [id])
  items     SupplierInvoiceItem[]
  payments  SupplierPayment[]

  @@index([branchId, status])
  @@index([supplierId])
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  productId   String?
  productName String
  quantity    Decimal  @db.Decimal(10, 3)
  unit        String   @default("piece")
  unitCost    Decimal  @db.Decimal(10, 2)
  lineTotal   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("supplier_invoice_items")
}

model SupplierPayment {
  id          String   @id @default(uuid())
  supplierId  String
  invoiceId   String?
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  paidAt      DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())

  supplier  Supplier         @relation(fields: [supplierId], references: [id])
  invoice   SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])

  @@index([supplierId])
  @@index([invoiceId])
  @@map("supplier_payments")
}

// ==================== CASH FLOW ====================

enum CashFlowMode {
  CASH_ONLY
  ALL_REVENUE
  RUNNING_BALANCE
}

enum CashEntryType {
  SALE_CASH_IN
  RESTOCK_OUT
  EXPENSE_OUT
  MANUAL_ADJUSTMENT
  OPENING_BALANCE
}

model BranchCashSettings {
  branchId  String       @id
  mode      CashFlowMode @default(CASH_ONLY)
  updatedAt DateTime     @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_cash_settings")
}

model CashLedgerEntry {
  id            String        @id @default(uuid())
  branchId      String
  type          CashEntryType
  amount        Decimal       @db.Decimal(10, 2)
  balanceAfter  Decimal       @db.Decimal(10, 2)
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String?
  createdAt     DateTime      @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // sumToday()/sumNegativeToday() in cash-flow.service.ts filter on all
  // three columns together (branchId, type, createdAt range) — this
  // composite lets Postgres seek directly instead of scanning every entry
  // for the branch and filtering type afterward. Old (branchId, createdAt)
  // index is now redundant since this one covers the same leading columns.
  @@index([branchId, type, createdAt])
  @@map("cash_ledger_entries")
}

// ==================== CASH RECONCILIATION ====================

model CashReconciliation {
  id           String       @id @default(uuid())
  branchId     String
  // Snapshot of CashFlowService.getAvailableCash() at the moment this
  // reconciliation was opened — a live/moving figure otherwise, so it must
  // be captured once and stored rather than recomputed later.
  expectedCash Decimal      @db.Decimal(10, 2)
  countedCash  Decimal      @db.Decimal(10, 2)
  // countedCash - expectedCash. Negative = shortfall (missing cash),
  // positive = overage (more cash than expected).
  discrepancy  Decimal      @db.Decimal(10, 2)
  cashMode     CashFlowMode
  periodStart  DateTime
  periodEnd    DateTime     @default(now())
  notes        String?
  countedById  String
  createdAt    DateTime     @default(now())

  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  countedBy User   @relation(fields: [countedById], references: [id])

  @@index([branchId, createdAt])
  @@map("cash_reconciliations")
}
